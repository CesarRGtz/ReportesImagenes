{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar Reportes TEOSA",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/generar-ejecutable.ps1",
                "-SoloCompilar"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$javac"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
