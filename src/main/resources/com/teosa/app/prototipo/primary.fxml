<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.teosa.app.prototipo.PrimaryController">

   <center>
      <HBox prefHeight="100.0" prefWidth="200.0" style="-fx-background-color: #f7fafc;" BorderPane.alignment="CENTER">

         <!-- Columna Izquierda: Formulario -->
         <ScrollPane fx:id="formScrollPane" fitToWidth="true" hbarPolicy="NEVER" prefWidth="380.0" style="-fx-background-color: transparent; -fx-background: #f7fafc;" vbarPolicy="AS_NEEDED">
            <content>
               <VBox spacing="10.0">
                  <padding>
                     <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                  </padding>
                  <children>
               <Label text="TEOSA - Sistema de Reportes" textFill="#1a202c" wrapText="true">
                  <font>
                     <Font name="System Bold" size="13.0" />
                  </font>
                  <VBox.margin>
                     <Insets bottom="5.0" />
                  </VBox.margin>
               </Label>

               <Label fx:id="lblConnectionStatus" text="Conectando..." textFill="#64748b" wrapText="true" />
               <HBox spacing="8.0">
                  <Button fx:id="btnImportar" maxWidth="Infinity" onAction="#handleImportarReporte" style="-fx-background-color: #ffffff; -fx-text-fill: #1e3a5f; -fx-border-color: #93c5fd; -fx-border-radius: 4px; -fx-cursor: hand;" text="Importar / Historial" HBox.hgrow="ALWAYS" />
                  <Button onAction="#handleNuevoReporte" style="-fx-background-color: #ffffff; -fx-text-fill: #475569; -fx-border-color: #cbd5e0; -fx-border-radius: 4px;" text="Nuevo" />
               </HBox>

               <Label text="Plantilla:" textFill="#4a5568" />
               <ComboBox fx:id="cmbPlantillas" maxWidth="Infinity" promptText="Formato predeterminado" />
               <Button maxWidth="Infinity" onAction="#handleTogglePersonalizacion" style="-fx-background-color: #ffffff; -fx-text-fill: #4338ca; -fx-border-color: #a5b4fc; -fx-border-radius: 4px; -fx-cursor: hand;" text="Personalizar formato" />

               <Label text="Datos del Servicio" textFill="#2b6cb0">
                  <font>
                     <Font name="System Bold" size="12.0" />
                  </font>
               </Label>

               <Label text="Cliente / Empresa:" textFill="#4a5568" />
               <TextField fx:id="txtCliente" promptText="Ej. CARGILL" style="-fx-background-color: white; -fx-border-color: #cbd5e0; -fx-border-radius: 4px;" />

               <VBox fx:id="serviceFieldsContainer" spacing="8.0">
               <Label fx:id="lblFecha" text="Fecha de Recepción de Equipo:" textFill="#4a5568" />
               <DatePicker fx:id="dpFecha" maxWidth="Infinity" />

               <Label fx:id="lblArea" text="Área:" textFill="#4a5568" />
               <TextField fx:id="txtArea" promptText="Ej. PLANTA" style="-fx-background-color: white; -fx-border-color: #cbd5e0; -fx-border-radius: 4px;" />

               <Label fx:id="lblRemision" text="Remisión:" textFill="#4a5568" />
               <TextField fx:id="txtRemision" promptText="Número de Remisión" style="-fx-background-color: white; -fx-border-color: #cbd5e0; -fx-border-radius: 4px;" />

               <Label fx:id="lblCotizacion" text="Cotización:" textFill="#4a5568" />
               <TextField fx:id="txtCotizacion" promptText="Cotización" style="-fx-background-color: white; -fx-border-color: #cbd5e0; -fx-border-radius: 4px;" />

               <Label fx:id="lblFactura" text="Factura:" textFill="#4a5568" />
               <TextField fx:id="txtFactura" promptText="Factura (opcional)" style="-fx-background-color: white; -fx-border-color: #cbd5e0; -fx-border-radius: 4px;" />

               <VBox fx:id="customFieldsContainer" spacing="8.0" />
               </VBox>

               <Label text="Datos del Equipo:" textFill="#4a5568" />
               <TextArea fx:id="txtDatosEquipo" prefHeight="50.0" promptText="Marca, modelo, serie..." style="-fx-background-color: white; -fx-border-color: #cbd5e0;" wrapText="true" />

               <Label text="Descripción del Trabajo:" textFill="#4a5568" />
               <TextArea fx:id="txtDescripcion" prefHeight="50.0" promptText="Descripción del trabajo realizado..." style="-fx-background-color: white; -fx-border-color: #cbd5e0;" wrapText="true" />

               <Label text="Evidencia Fotográfica:" textFill="#4a5568" />
               <Button maxWidth="Infinity" onAction="#handleAgregarCategoria" style="-fx-background-color: #dbeafe; -fx-text-fill: #1e3a5f; -fx-border-color: #93c5fd; -fx-border-radius: 4px; -fx-cursor: hand;" text="Agregar categoría / actividad" />
               <Button maxWidth="Infinity" onAction="#handleAgregarFoto" style="-fx-background-color: #edf2f7; -fx-text-fill: #2d3748; -fx-border-color: #cbd5e0; -fx-border-radius: 4px; -fx-cursor: hand;" text="Agregar fotos a la última categoría" />
               <VBox fx:id="photoControls" spacing="8.0" />

               <VBox prefHeight="5.0" />

               <Button fx:id="btnGenerarPDF" maxWidth="Infinity" onAction="#handleClicAccion" style="-fx-background-color: #2b6cb0; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px; -fx-background-radius: 4px; -fx-cursor: hand;" text="Generar PDF Profesional" />

               <Button fx:id="btnGuardarServidor" maxWidth="Infinity" onAction="#handleGuardarServidor" style="-fx-background-color: #4f46e5; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px; -fx-background-radius: 4px; -fx-cursor: hand;" text="Guardar reporte en el servidor" />
               
               <Button fx:id="btnImprimir" maxWidth="Infinity" onAction="#handleImprimir" style="-fx-background-color: #319795; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px; -fx-background-radius: 4px; -fx-cursor: hand;" text="Imprimir Documento" />
                  </children>
               </VBox>
            </content>
         </ScrollPane>

         <!-- Columna Derecha: Previsualización tipo Word -->
         <VBox HBox.hgrow="ALWAYS" spacing="10.0" style="-fx-background-color: #cbd5e0;">
            <padding>
               <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
               <Label text="Previsualización de Páginas (Estilo Word)" textFill="#2d3748">
                  <font>
                     <Font name="System Bold" size="12.0" />
                  </font>
               </Label>
               <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #cbd5e0;" VBox.vgrow="ALWAYS">
                  <content>
                     <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: transparent;">
                        <padding>
                           <Insets bottom="30.0" top="10.0" />
                        </padding>
                        <children>
                           <!-- Aquí se inyectan dinámicamente las páginas tipo Word -->
                           <VBox fx:id="panePreview" alignment="TOP_CENTER" spacing="20.0" style="-fx-background-color: transparent;" />
                        </children>
                     </VBox>
                  </content>
               </ScrollPane>
            </children>
         </VBox>

      </HBox>
   </center>

   <right>
      <VBox fx:id="customizationDrawer" managed="false" prefWidth="370.0" style="-fx-background-color: #ffffff; -fx-border-color: #cbd5e0; -fx-border-width: 0 0 0 1;" visible="false">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0" style="-fx-background-color: #eef2ff; -fx-padding: 12px;">
               <Label text="Personalizar formato" textFill="#312e81">
                  <font><Font name="System Bold" size="13.0" /></font>
               </Label>
               <Region HBox.hgrow="ALWAYS" />
               <Button onAction="#handleTogglePersonalizacion" text="Cerrar" />
            </HBox>
            <ScrollPane fx:id="customizationScrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <VBox fx:id="customizationContent" spacing="10.0">
                     <padding><Insets bottom="18.0" left="12.0" right="12.0" top="12.0" /></padding>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </VBox>
   </right>
</BorderPane>
